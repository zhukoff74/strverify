from typing import ClassVar, NoReturn, Union

__all__ = ["CharSet", "Filter", "__version__"]
__version__: str

CharSetLike = Union[str, "CharSet"]

class CharSet:
    """An immutable union of Unicode character classes and literal characters."""

    CYRILLIC: ClassVar[CharSet]
    LATIN: ClassVar[CharSet]
    LETTERS: ClassVar[CharSet]
    DIGITS: ClassVar[CharSet]
    ASCII_DIGITS: ClassVar[CharSet]
    PUNCTUATION: ClassVar[CharSet]
    SYMBOLS: ClassVar[CharSet]
    WHITESPACE: ClassVar[CharSet]
    ASCII: ClassVar[CharSet]

    @staticmethod
    def of(chars: str) -> CharSet: ...
    @staticmethod
    def empty() -> CharSet: ...
    def __or__(self, other: CharSet) -> CharSet: ...
    def __contains__(self, value: str) -> bool: ...
    def __repr__(self) -> str: ...

class Filter:
    """An immutable, composable predicate over text content."""

    @staticmethod
    def always() -> Filter: ...
    @staticmethod
    def never() -> Filter: ...
    @staticmethod
    def non_empty() -> Filter: ...
    @staticmethod
    def only(chars: CharSetLike) -> Filter: ...
    @staticmethod
    def none_of(chars: CharSetLike) -> Filter: ...
    @staticmethod
    def contains(chars: CharSetLike) -> Filter: ...
    @staticmethod
    def only_cyrillic() -> Filter: ...
    @staticmethod
    def only_latin() -> Filter: ...
    @staticmethod
    def only_digits() -> Filter: ...
    @staticmethod
    def no_digits() -> Filter: ...
    @staticmethod
    def only_digits_and(chars: CharSetLike) -> Filter: ...
    @staticmethod
    def only_digits_and_cyrillic() -> Filter: ...
    @staticmethod
    def only_digits_and_underscore() -> Filter: ...
    @staticmethod
    def only_symbols() -> Filter: ...
    @staticmethod
    def all_of(*filters: Filter) -> Filter: ...
    @staticmethod
    def any_of(*filters: Filter) -> Filter: ...
    def matches(self, text: str) -> bool: ...
    def __call__(self, text: str) -> bool: ...
    def __and__(self, other: Filter) -> Filter: ...
    def __or__(self, other: Filter) -> Filter: ...
    def __invert__(self) -> Filter: ...
    def __bool__(self) -> NoReturn: ...
    def __repr__(self) -> str: ...
